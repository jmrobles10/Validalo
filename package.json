{
  "name": "validalo-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @validalo/web dev",
    "lint": "eslint . --max-warnings 0",
    "lint:rapido": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/ --concurrency=auto",
    "typecheck": "pnpm -r --parallel typecheck",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "generar:api": "pnpm --filter @validalo/api-client generar",
    "semilla:dev": "pnpm --filter @validalo/web semilla",
    "semilla:plataforma": "pnpm --filter @validalo/web semilla:plataforma",
    "dev:public": "pnpm --filter @validalo/public dev",
    "e2e": "pnpm --filter @validalo/e2e test",
    "manual": "node e2e/manual/generador/manual.mjs",
    "manual:recorrer": "pnpm --filter @validalo/e2e manual:recorrer",
    "manual:todo": "pnpm manual:recorrer && pnpm manual"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^16.4.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.0",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
